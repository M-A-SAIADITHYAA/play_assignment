{
  "$schema": "https://json.schemastore.org/partial-claude-code-settings.json",
  "project": {
    "name": "airbnb-clone",
    "description": "Pixel-perfect Airbnb desktop listing page clone for Playpower Labs take-home assessment",
    "framework": "nextjs",
    "language": "typescript"
  },
  "build": {
    "buildCommand": "npm run build",
    "devCommand": "npm run dev",
    "lintCommand": "npm run lint"
  },
  "ignorePatterns": [
    "node_modules/**",
    ".next/**",
    ".git/**",
    "*.log"
  ]
}
